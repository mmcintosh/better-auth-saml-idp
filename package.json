{
  "name": "better-auth-saml-idp",
  "version": "1.7.0",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "xml-crypto": "^6.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@authenio/samlify-node-xmllint": "2.0.0",
    "@better-auth/core": "1.7.12",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@node-saml/node-saml": "^5.1.0",
    "@playwright/test": "^1.64.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "better-auth": "1.7.12",
    "better-auth-cloudflare": "^0.4.1",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "libxml2-wasm": "0.7.2",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.0",
    "prisma": "7.10.1",
    "publint": "^0.3.24",
    "samlify": "2.13.1",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workerd": "vitest run --project workerd",
    "typecheck": "tsc -p tsconfig.json",
    "build:schemas": "node scripts/build-schemas.mjs",
    "test:wasm": "vitest run --config wasm-validator/vitest.config.ts",
    "e2e": "node e2e/lib/tls.mjs && NODE_EXTRA_CA_CERTS=\"$PWD/e2e/.generated/tls/ca.pem\" playwright test -c e2e/playwright.config.mjs",
    "smoke:live": "pnpm build && node dist/cli/bin.js smoke",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "docs:check": "node scripts/check-links.mjs",
    "pack:check": "pnpm build && tsc -p tsconfig.strict-host.json && node node_modules/typescript-5/bin/tsc -p tsconfig.strict-host.json && publint --strict && attw --pack . --profile esm-only",
    "lint": "biome lint --error-on-warnings",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.7.8 <1.8.0",
    "better-auth": ">=1.7.8 <1.8.0"
  },
  "imports": {
    "#xsd-wasm": {
      "workerd": "./dist/saml/wasm/load.workerd.js",
      "default": "./dist/saml/wasm/load.node.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Unofficial Better Auth plugin: act as a SAML 2.0 Identity Provider (SP- and IdP-initiated SSO, encrypted assertions). Runs on Cloudflare Workers and Node. Includes a CLI.",
  "author": "Mark McIntosh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmcintosh/better-auth-saml-idp.git"
  },
  "homepage": "https://github.com/mmcintosh/better-auth-saml-idp#readme",
  "bugs": {
    "url": "https://github.com/mmcintosh/better-auth-saml-idp/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "saml",
    "saml2",
    "idp",
    "identity-provider",
    "sso",
    "single-sign-on",
    "cloudflare-workers",
    "microsoft-365",
    "entra-id",
    "google-workspace",
    "okta",
    "salesforce"
  ],
  "packageManager": "pnpm@10.34.6",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7.15.0 <7.30.1": "^7.30.1",
      "zod@<4.6.6": "^4.6.6"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm/xsd.wasm",
    "wasm/xsd.wasm.sha256",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "bin": {
    "better-auth-saml-idp": "./dist/cli/bin.js"
  }
}
