{
  "name": "better-auth-saml-idp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "samlify": "2.13.1",
    "xml-crypto": "^6.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@authenio/samlify-node-xmllint": "2.0.0",
    "@better-auth/core": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/sso": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@node-saml/node-saml": "^5.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "better-auth": "1.7.5",
    "better-auth-cloudflare": "file:vendor/better-auth-cloudflare-0.3.1-main-dbe08c51b.tgz",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "libxml2-wasm": "0.7.2",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.139.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workerd": "vitest run --project workerd",
    "typecheck": "tsc -p tsconfig.json",
    "build:schemas": "node scripts/build-schemas.mjs",
    "test:wasm": "vitest run --config wasm-validator/vitest.config.ts",
    "e2e": "node e2e/lib/tls.mjs && NODE_EXTRA_CA_CERTS=\"$PWD/e2e/.generated/tls/ca.pem\" playwright test -c e2e/playwright.config.mjs",
    "smoke:live": "node --network-family-autoselection-attempt-timeout=3000 e2e/live/smoke.mjs",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "pack:check": "pnpm build && publint --strict && attw --pack . --profile esm-only",
    "lint": "biome lint --error-on-warnings"
  },
  "peerDependencies": {
    "@better-auth/core": ">=1.7.5 <1.8.0",
    "better-auth": ">=1.7.5 <1.8.0"
  },
  "imports": {
    "#xsd-wasm": {
      "workerd": "./dist/saml/wasm/load.workerd.js",
      "default": "./dist/saml/wasm/load.node.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Unofficial Better Auth plugin: act as a SAML 2.0 Identity Provider (SP-initiated SSO). Runs on Cloudflare Workers and Node.",
  "author": "Mark McIntosh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmcintosh/better-auth-saml-idp.git"
  },
  "homepage": "https://github.com/mmcintosh/better-auth-saml-idp#readme",
  "bugs": {
    "url": "https://github.com/mmcintosh/better-auth-saml-idp/issues"
  },
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "saml",
    "saml2",
    "idp",
    "identity-provider",
    "sso",
    "cloudflare-workers",
    "hubspot"
  ],
  "packageManager": "pnpm@10.10.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm/xsd.wasm",
    "wasm/xsd.wasm.sha256",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false
}
