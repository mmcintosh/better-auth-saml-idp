{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["src"],
  // The CLI is a Node binary, not an API: no declarations (and it uses Node-only Buffer APIs).
  "exclude": ["src/cli"]
}
