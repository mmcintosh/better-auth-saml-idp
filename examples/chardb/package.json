    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "msw": "3.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
